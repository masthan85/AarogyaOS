# Development-only settings for `docker compose`, with values that are safe because they protect nothing:
# an empty database on your own machine. NEVER use these values anywhere real.
#
# From the repository root:
#   docker compose --env-file infrastructure/dev.env -f infrastructure/docker-compose.yml up --build
#
# To use Sarvam and the real language model, put your key in a file called .env in the repository root
# (it is ignored by git) and add it as a second --env-file (see docs/DEVELOPMENT.md).
AAROGYA_ENVIRONMENT=development
POSTGRES_SUPERUSER_PASSWORD=dev-superuser-password
AAROGYA_APP_DB_PASSWORD=dev-app-password
AAROGYA_JWT_SECRET=dev-only-secret-change-me-dev-only-secret
AAROGYA_FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQta2V5LTMyLWJ5dGVzLXh4eHg=
