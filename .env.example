# Copy to .env for local development. Never commit .env or real credentials.
AAROGYA_ENVIRONMENT=development
# Must connect as a NON-superuser role: Postgres superusers bypass row-level security.
AAROGYA_DATABASE_URL=postgresql+psycopg://aarogya_app:change-me@localhost:5432/aarogya
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Production startup is refused if this is the default or shorter than 32 chars.
# Leave commented in development to use the built-in development secret.
# AAROGYA_JWT_SECRET=
# Encrypts ABHA numbers and other sensitive identifiers (AES-256-GCM) and keys their lookup index.
# Generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# BACK THIS UP: losing it makes stored identifiers unrecoverable. Required in production.
# Leave commented in development to use the built-in development key. A variable that is present but
# empty is NOT the same as absent: an empty value stops the API from starting.
# AAROGYA_FIELD_ENCRYPTION_KEY=
# After a rotation, list the older key(s) here, comma separated, until `rotate-field-key` has run.
AAROGYA_FIELD_ENCRYPTION_PREVIOUS_KEYS=
# Optional dedicated keys for the prescription seal (base64 of 32 random bytes, comma separated, first signs).
# Empty: derived from the field encryption key. Set before rotating that key if seals must survive it.
# AAROGYA_SEAL_KEYS=
AAROGYA_ACCESS_TOKEN_MINUTES=15
AAROGYA_REFRESH_TOKEN_DAYS=14
AAROGYA_CORS_ORIGINS=[]
AAROGYA_LOG_LEVEL=INFO

# docker-compose only
POSTGRES_SUPERUSER_PASSWORD=change-me-too
AAROGYA_APP_DB_PASSWORD=change-me

# Mobile (public values only — anything EXPO_PUBLIC_* is shipped inside the app)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
# Dev builds use simulated audio; set to 1 to use the real microphone (needs a dev/release build, not Expo Go).
EXPO_PUBLIC_USE_MICROPHONE=

# Speech. Empty defaults to the synthetic 'development' provider outside production; production must
# choose a real adapter explicitly (the Sarvam adapter is built; see docs/SPEECH_ARCHITECTURE.md).
AAROGYA_SPEECH_PROVIDER=
AAROGYA_SPEECH_FALLBACK_PROVIDER=
# Vendors approved to receive patient data, as a JSON list, e.g. ["sarvam"]. Production refuses to
# start if any provider configured in this file (the fallback included) is missing from it. Add a
# vendor only once its data-processing agreement is signed. Development ignores this.
AAROGYA_PATIENT_DATA_PROVIDERS=[]
# One live instance: a second worker or container reports "standby" and refuses recordings. On by
# default in production and off elsewhere; set true or false to override.
# AAROGYA_SINGLE_INSTANCE_GUARD=
# Sarvam AI streaming STT (set AAROGYA_SPEECH_PROVIDER=sarvam). Adapter written from the vendor SDK,
# tested against a local fake and run live once with a short English clip: run
# scripts/sarvam_live_check.py with your key first.
AAROGYA_SARVAM_API_KEY=
AAROGYA_SARVAM_MODEL=saaras:v4
AAROGYA_SARVAM_MODE=transcribe
# false = let Sarvam detect the language of each utterance (better for mixed-language consultations)
AAROGYA_SARVAM_USE_LANGUAGE_HINT=false
# Sarvam REST services share the key above. Each is OFF until chosen (see docs/SARVAM.md).
AAROGYA_TRANSLATION_PROVIDER=        # sarvam: translate patient summaries (doctor reviews before approving)
AAROGYA_TTS_PROVIDER=                # sarvam: read approved summaries aloud
AAROGYA_SELF_HOSTED_LLM_URL=      # e.g. http://127.0.0.1:8000/v1 (vLLM) or http://127.0.0.1:11434/v1 (Ollama)
AAROGYA_SELF_HOSTED_LLM_MODEL=
AAROGYA_SELF_HOSTED_LLM_API_KEY=
AAROGYA_SELF_HOSTED_LLM_JSON_MODE=false   # true only if your server supports response_format json_object
AAROGYA_SARVAM_LLM_MODEL=sarvam-105b # used when AAROGYA_LLM_PROVIDER=sarvam
AAROGYA_SPEECH_MAX_SESSION_SECONDS=3600
# Development audio store only; production uses encrypted object storage.
AAROGYA_AUDIO_STORE_PATH=/tmp/aarogya-audio

# Clinical AI. Empty defaults to the naive 'development' providers outside production; production must
# choose real adapters explicitly: sarvam, anthropic or self_hosted for the model. No embedding vendor
# adapter is built yet.
AAROGYA_LLM_PROVIDER=
# Anthropic (Claude): set AAROGYA_LLM_PROVIDER=anthropic. Needs a signed data-processing agreement
# and a residency decision before any patient data. Never set ANTHROPIC_LOG=debug in production.
AAROGYA_ANTHROPIC_API_KEY=
AAROGYA_ANTHROPIC_MODEL=claude-opus-5-5
AAROGYA_EMBEDDING_PROVIDER=
AAROGYA_LLM_TIMEOUT_SECONDS=60
AAROGYA_AI_ANALYSES_PER_MINUTE=6

# Operations. /metrics is disabled in production until a token is set.
AAROGYA_METRICS_TOKEN=
AAROGYA_MAX_REQUEST_BYTES=5000000
